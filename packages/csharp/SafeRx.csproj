<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>SafeRx</PackageId>
    <Version>2.0.2</Version>
    <Authors>SafeRx</Authors>
    <Description>Signing-aware SafeRx Enterprise API preview client.</Description>
    <PackageTags>saferx;enterprise-api;medication-safety</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://docs.saferx.online</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KaRamHelal/SafeRx_Pharma</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
