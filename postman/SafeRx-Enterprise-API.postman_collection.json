{
  "info": {
    "name": "SafeRx Enterprise API preview",
    "description": "Signed-request examples for the MIS Enterprise preview contract. Inject the key locally; never save a credential in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://saferx.online/api/enterprise/v1"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": "postman-safety-001"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const CryptoJS = require('crypto-js');",
          "const url = pm.request.url.toString();",
          "const parsed = new URL(url);",
          "const query = [...parsed.searchParams.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`).join('&');",
          "const query = parsed.search.replace(/^\\?/, '');",
          "const body = pm.request.body && pm.request.body.mode === 'raw' ? pm.request.body.raw : '';",
          "const timestamp = new Date().toISOString();",
          "const nonce = pm.variables.replaceIn('{{$guid}}');",
          "const bodyHash = CryptoJS.SHA256(body).toString(CryptoJS.enc.Hex);",
          "const canonical = [pm.request.method.toUpperCase(), encodeURI(path), query, bodyHash, timestamp, nonce].join('\\n');",
          "const signature = CryptoJS.HmacSHA256(canonical, pm.variables.get('api_key')).toString(CryptoJS.enc.Base64).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "pm.request.headers.upsert({key:'X-SafeRx-API-Key', value:pm.variables.get('api_key')});",
          "pm.request.headers.upsert({key:'X-SafeRx-Timestamp', value:timestamp});",
          "pm.request.headers.upsert({key:'X-SafeRx-Nonce', value:nonce});",
          "pm.request.headers.upsert({key:'X-SafeRx-Signature', value:signature});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/status"
      }
    },
    {
      "name": "Capabilities",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/capabilities"
      }
    },
    {
      "name": "Registry search",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/registry/search?q=Augmentin&locale=en&limit=10"
      }
    },
    {
      "name": "Safety check",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Idempotency-Key', value:pm.variables.get('idempotency_key')});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"locale\": \"en\",\n  \"medications\": [\n    {\n      \"input_text\": \"Augmentin 1g\"\n    }\n  ],\n  \"requested_domains\": [\n    \"ddi\",\n    \"food_interactions\"\n  ]\n}"
        },
        "url": "{{base_url}}/safety/checks"
      }
    }
  ]
}
